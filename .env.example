# ===========================================
# AttendEase — Environment Configuration Template
# ===========================================
# Copy this file to .env and fill in your values.
# ===========================================

# Django
# Development-only key; use a generated secret key outside local development.
DJANGO_SECRET_KEY=change-me-to-a-real-secret-key
DJANGO_DEBUG=True

# Local development uses SQLite by default. Set this to False to use Supabase PostgreSQL.
USE_SQLITE=True

# Supabase Database (PostgreSQL), required when USE_SQLITE=False
# Copy the connection details from Supabase Dashboard → Project Settings → Database.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=

# Supabase Auth, required for Supabase-backed authentication
# Copy the project URL and anon/publishable key from Supabase Dashboard → Project Settings → API.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Firebase Google sign-in
# Firebase web-app configuration (not a private credential).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
# Path to a local Firebase Admin service-account JSON, kept out of version control.
FIREBASE_ADMIN_CREDENTIALS=
