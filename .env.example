# ===========================================
# AttendEase — Environment Configuration Template
# ===========================================
# Copy this file to .env and fill in your values.
# ===========================================

# Django
DJANGO_SECRET_KEY=change-me-to-a-real-secret-key
DJANGO_DEBUG=True

# Supabase Database (PostgreSQL)
# Get these from: Supabase Dashboard → Settings → Database
SUPABASE_DB_HOST=db.xyzxyz.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=

# Supabase API (for authentication)
# Get these from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://xyzxyz.supabase.co
SUPABASE_ANON_KEY=
